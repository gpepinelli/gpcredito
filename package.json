{
  "name": "gpcredito",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento de emprestimos - GPCredito",
  "main": "backend/src/index.js",
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "nodemon backend/src/index.js",
    "db:migrate": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema backend/prisma/schema.prisma",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "contract:example": "python backend/scripts/gerar_contrato_exemplo.py"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "prisma": "^5.14.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
