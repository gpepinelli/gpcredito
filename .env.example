# Banco de dados
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/gpcredito?schema=public"

# Servidor
PORT=3000
APP_URL="http://localhost:3000"
NODE_ENV=development

# CORS
# Para varias origens, separar por virgula:
# CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Autenticacao
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_DELETE_PASSWORD="troque-esta-senha-de-exclusao"
ADMIN_TOKEN_SECRET="troque-este-segredo-longo-e-aleatorio"

# Regras operacionais de credito
# Tambem podem ser alteradas no painel em Configuracoes.
JUROS_PADRAO=30
JUROS_MINIMO=0
JUROS_MAXIMO=100
VALOR_MINIMO_EMPRESTIMO=10
VALOR_MAXIMO_EMPRESTIMO=100000
PARCELAS_MINIMAS=1
PARCELAS_MAXIMAS=60
INTERVALO_PARCELAS_DIAS=30
ALLOW_MULTIPLE_ACTIVE_OPERATIONS=false
DIAS_PRIMEIRO_VENCIMENTO=30

# Score
SCORE_INICIAL=100
SCORE_MINIMO=0
SCORE_MAXIMO=200
SCORE_LIMITE_BLOQUEADO=50
SCORE_LIMITE_RISCO_MEDIO=80
SCORE_PAGAMENTO_ANTECIPADO=15
SCORE_PAGAMENTO_EM_DIA=10
SCORE_ATRASO_ATE_3_DIAS=-10
SCORE_ATRASO_4_A_7_DIAS=-15
SCORE_ATRASO_ACIMA_7_DIAS=-25
SCORE_PENALIDADE_INADIMPLENCIA=-50

# Cobrancas e renovacao
COBRANCA_HORA_MANHA="09:00"
COBRANCA_HORA_TARDE="18:00"
RENOVACAO_HORA="09:30"
DIAS_INADIMPLENCIA_PENALIDADE=8
RENOVACAO_DIAS_APOS_QUITACAO=15

# Vendas
JUROS_VENDA_PADRAO=30
VALOR_MINIMO_VENDA=1

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_ATIVO=false
PIX_AUTOMATICO_VENCIMENTO=false
# Configure com o segredo do webhook no painel do Mercado Pago para validar x-signature.
MP_WEBHOOK_SECRET=""

# Pix manual
PIX_CHAVE=""
PIX_NOME=""
PIX_CIDADE="SAO PAULO"

# Sistema
NOME_EMPRESA="GPCredito"
TOKEN_EXPIRACAO_HORAS=8
UPLOAD_TAMANHO_MAXIMO_MB=5
UPLOAD_TIPOS_PERMITIDOS="jpg,png,pdf"
LOG_NIVEL=info
TIMEZONE="America/Sao_Paulo"

# WhatsApp
# Use "mock" em desenvolvimento e "baileys" para envio real.
WHATSAPP_ADAPTER=mock
WHATSAPP_SESSION_PATH="./whatsapp-session"

# Telegram interno
# Crie um bot no @BotFather e configure o chat que pode controlar os comandos.
TELEGRAM_ATIVO=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Python do gerador de contratos.
# Deixe vazio para deteccao automatica.
# PYTHON_BIN="python"
