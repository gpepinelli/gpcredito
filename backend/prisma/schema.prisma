// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id         String   @id @default(uuid())
  nome       String
  cpf        String?  @unique
  telefone   String   @unique
  endereco   String?
  score      Int      @default(100)
  criadoEm   DateTime @default(now()) @map("criado_em")

  emprestimos    Emprestimo[]
  historicoScore HistoricoScore[]
  documentos     DocumentoCliente[]
  contratos      ContratoOperacao[]
  vendas         VendaProduto[]
  orcamentos     Orcamento[]
  arquivosPdf    ArquivoPdf[]
  promessasPagamento PromessaPagamento[]

  @@map("clientes")
}

model ProdutoVenda {
  id              String   @id @default(uuid())
  tipo            TipoProdutoVenda
  titulo          String
  descricao       String?
  marca           String?
  modelo          String?
  ano             Int?
  identificador   String?  @unique
  valorCusto      Float    @default(0) @map("valor_custo")
  valorVenda      Float    @map("valor_venda")
  status          StatusProdutoVenda @default(DISPONIVEL)
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  vendas VendaProduto[]

  @@index([tipo])
  @@index([status])
  @@map("produtos_venda")
}

model VendaProduto {
  id              String   @id @default(uuid())
  produtoId       String   @map("produto_id")
  clienteId       String?  @map("cliente_id")
  compradorNome   String   @map("comprador_nome")
  compradorTelefone String? @map("comprador_telefone")
  valorBase       Float    @map("valor_base")
  valorVenda      Float    @map("valor_venda")
  valorEntrada    Float    @default(0) @map("valor_entrada")
  jurosPercentual Float    @default(30) @map("juros_percentual")
  valorParcela    Float    @default(0) @map("valor_parcela")
  parcelas        Int      @default(1)
  observacao      String?
  status          StatusVendaProduto @default(ABERTA)
  criadoEm        DateTime @default(now()) @map("criado_em")
  concluidoEm     DateTime? @map("concluido_em")

  produto ProdutoVenda @relation(fields: [produtoId], references: [id])
  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@index([produtoId])
  @@index([clienteId])
  @@index([status])
  @@map("vendas_produto")
}

model Emprestimo {
  id              String   @id @default(uuid())
  clienteId       String   @map("cliente_id")
  numeroOperacao  String   @unique @map("numero_operacao")
  numeroContrato  String?  @unique @map("numero_contrato")
  valor           Float
  juros           Float
  valorTotal      Float    @map("valor_total")
  dataEmprestimo  DateTime @default(now()) @map("data_emprestimo")
  dataVencimento  DateTime @map("data_vencimento")
  status          StatusEmprestimo @default(pendente)
  statusOperacao  StatusOperacao @default(EM_DIA) @map("status_operacao")
  renovacaoOferecidaEm DateTime? @map("renovacao_oferecida_em")
  scorePenalizadoInadimplenciaEm DateTime? @map("score_penalizado_inadimplencia_em")
  // Parcelamento
  totalParcelas   Int      @default(1) @map("total_parcelas")
  pixQrCode       String?  @map("pix_qr_code")
  pixCopiaCola    String?  @map("pix_copia_cola")
  pixPaymentId    String?  @map("pix_payment_id")
  observacao      String?

  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  pagamentos Pagamento[]
  pixCobrancas PixCobranca[]
  parcelas   Parcela[]
  contratos  ContratoOperacao[]
  carteiraMovimentacoes CarteiraMovimentacao[]
  promessasPagamento PromessaPagamento[]

  @@map("emprestimos")
}

model DocumentoCliente {
  id              String   @id @default(uuid())
  clienteId       String   @map("cliente_id")
  tipoDocumento   TipoDocumentoCliente @map("tipo_documento")
  nomeOriginal    String   @map("nome_original")
  nomeArquivo     String   @map("nome_arquivo")
  caminhoArquivo  String   @map("caminho_arquivo")
  mimeType        String   @map("mime_type")
  tamanhoBytes    Int      @map("tamanho_bytes")
  statusValidacao StatusValidacaoDocumento @default(PENDENTE) @map("status_validacao")
  observacao      String?
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("documentos_cliente")
}

model ContratoOperacao {
  id              String   @id @default(uuid())
  numeroContrato  String   @unique @map("numero_contrato")
  numeroOperacao  String   @map("numero_operacao")
  clienteId       String   @map("cliente_id")
  emprestimoId    String?  @map("emprestimo_id")
  caminhoArquivo  String   @map("caminho_arquivo")
  hashSha256      String   @default("") @map("hash_sha256")
  statusContrato  StatusContrato @default(GERADO) @map("status_contrato")
  criadoEm        DateTime @default(now()) @map("criado_em")
  aceitoEm        DateTime? @map("aceito_em")

  cliente    Cliente @relation(fields: [clienteId], references: [id])
  emprestimo Emprestimo? @relation(fields: [emprestimoId], references: [id])

  @@index([clienteId])
  @@index([numeroOperacao])
  @@map("contratos_operacao")
}

// Parcela individual de um empréstimo parcelado
model Parcela {
  id            String   @id @default(uuid())
  emprestimoId  String   @map("emprestimo_id")
  numero        Int      // 1, 2, 3...
  valor         Float    // valor total da parcela
  amortizacao   Float    @default(0)
  valorJuros    Float    @default(0) @map("valor_juros")
  saldoAntes    Float    @default(0) @map("saldo_antes")
  saldoDepois   Float    @default(0) @map("saldo_depois")
  dataVencimento DateTime @map("data_vencimento")
  status        StatusParcela @default(pendente)
  dataPagamento DateTime? @map("data_pagamento")

  emprestimo Emprestimo @relation(fields: [emprestimoId], references: [id])
  pagamentos Pagamento[]
  pixCobrancas PixCobranca[]

  @@map("parcelas")
}

model Pagamento {
  id            String   @id @default(uuid())
  emprestimoId  String   @map("emprestimo_id")
  parcelaId     String?  @map("parcela_id")
  valorPago     Float    @map("valor_pago")
  dataPagamento DateTime @default(now()) @map("data_pagamento")
  status        StatusPagamento @default(pendente)
  caminhoPdf    String?  @map("caminho_pdf")

  emprestimo Emprestimo @relation(fields: [emprestimoId], references: [id])
  parcela    Parcela?   @relation(fields: [parcelaId], references: [id])

  @@map("pagamentos")
}

model HistoricoScore {
  id        String   @id @default(uuid())
  clienteId String   @map("cliente_id")
  alteracao Int
  motivo    String
  data      DateTime @default(now())

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@map("historico_score")
}

model Log {
  id        String   @id @default(uuid())
  tipo      String
  mensagem  String
  dados     Json?
  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("logs")
}

model Orcamento {
  id                String          @id @default(uuid())
  clienteId         String?         @map("cliente_id")
  valor             Float
  juros             Float
  parcelas          Int
  primeiroVencimento DateTime       @map("primeiro_vencimento")
  caminhoPdf        String?         @map("caminho_pdf")
  status            StatusOrcamento @default(PENDENTE)
  criadoEm          DateTime        @default(now()) @map("criado_em")
  expiradoEm        DateTime?       @map("expirado_em")

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([status])
  @@map("orcamentos")
}

model ArquivoPdf {
  id          String   @id @default(uuid())
  clienteId   String?  @map("cliente_id")
  tipo        TipoArquivoPdf
  origemTipo  String?  @map("origem_tipo")
  origemId    String?  @map("origem_id")
  caminhoPdf  String   @map("caminho_pdf")
  criadoEm    DateTime @default(now()) @map("criado_em")

  cliente Cliente? @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([tipo])
  @@index([origemTipo, origemId])
  @@map("arquivos_pdf")
}

model Configuracao {
  id          String              @id @default(uuid())
  chave       String              @unique
  valor       String
  tipo        TipoConfiguracao
  categoria   CategoriaConfiguracao
  descricao   String
  obrigatorio Boolean             @default(false)
  criadoEm    DateTime            @default(now()) @map("criado_em")
  atualizadoEm DateTime           @updatedAt @map("atualizado_em")

  @@index([categoria])
  @@map("configuracoes")
}

model CarteiraMovimentacao {
  id           String                 @id @default(uuid())
  tipo         TipoMovimentacaoCarteira
  valor        Float
  descricao    String?
  emprestimoId String?                @map("emprestimo_id")
  criadoEm     DateTime               @default(now()) @map("criado_em")

  emprestimo Emprestimo? @relation(fields: [emprestimoId], references: [id], onDelete: SetNull)

  @@index([tipo])
  @@index([emprestimoId])
  @@map("carteira_movimentacoes")
}

model PromessaPagamento {
  id            String   @id @default(uuid())
  clienteId     String   @map("cliente_id")
  emprestimoId  String   @map("emprestimo_id")
  valor         Float
  dataPrometida DateTime @map("data_prometida")
  observacao    String?
  status        StatusPromessaPagamento @default(PENDENTE)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  cliente    Cliente    @relation(fields: [clienteId], references: [id])
  emprestimo Emprestimo @relation(fields: [emprestimoId], references: [id])

  @@index([clienteId])
  @@index([emprestimoId])
  @@index([status])
  @@map("promessas_pagamento")
}

model PixCobranca {
  id            String   @id @default(uuid())
  emprestimoId  String   @map("emprestimo_id")
  parcelaId     String?  @map("parcela_id")
  paymentId     String   @unique @map("payment_id")
  valor         Float
  copiaCola     String?  @map("copia_cola")
  qrCode        String?  @map("qr_code")
  status        StatusPixCobranca @default(PENDENTE)
  criadoEm      DateTime @default(now()) @map("criado_em")
  pagoEm        DateTime? @map("pago_em")

  emprestimo Emprestimo @relation(fields: [emprestimoId], references: [id])
  parcela    Parcela?   @relation(fields: [parcelaId], references: [id])

  @@index([emprestimoId])
  @@index([parcelaId])
  @@index([status])
  @@map("pix_cobrancas")
}

model LoginRateLimit {
  id           String   @id @default(uuid())
  chave        String   @unique
  tentativas   Int      @default(0)
  bloqueadoAte DateTime? @map("bloqueado_ate")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("login_rate_limits")
}

model NumeracaoSequencial {
  id           String   @id @default(uuid())
  chave        String   @unique
  valor        Int      @default(0)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("numeracoes_sequenciais")
}

enum StatusEmprestimo {
  pendente
  pago
  atrasado
}

enum StatusPagamento {
  confirmado
  pendente
}

enum StatusParcela {
  pendente
  pago
  atrasado
}

enum StatusOperacao {
  AGUARDANDO_ACEITE
  APROVADO
  LIBERADO
  EM_DIA
  ATRASADO
  QUITADO
  CANCELADO
  RECUSADO
}

enum StatusContrato {
  GERADO
  ENVIADO
  ACEITO
  CANCELADO
}

enum TipoDocumentoCliente {
  RG_FRENTE
  RG_VERSO
  COMPROVANTE_ENDERECO
}

enum StatusValidacaoDocumento {
  PENDENTE
  APROVADO
  RECUSADO
}

enum TipoProdutoVenda {
  CARRO
  MOTO
  CELULAR
}

enum StatusProdutoVenda {
  DISPONIVEL
  RESERVADO
  VENDIDO
  INATIVO
}

enum StatusVendaProduto {
  ABERTA
  CONCLUIDA
  CANCELADA
}

enum TipoConfiguracao {
  STRING
  NUMBER
  BOOLEAN
  TIME
}

enum CategoriaConfiguracao {
  CREDITO
  SCORE
  COBRANCA
  VENDAS
  PIX
  SISTEMA
}

enum StatusOrcamento {
  PENDENTE
  CONVERTIDO
  EXPIRADO
}

enum TipoArquivoPdf {
  CONTRATO
  ORCAMENTO
  COBRANCA
  RECIBO
}

enum TipoMovimentacaoCarteira {
  ENTRADA
  SAIDA
}

enum StatusPromessaPagamento {
  PENDENTE
  CUMPRIDA
  NAO_CUMPRIDA
  CANCELADA
}

enum StatusPixCobranca {
  PENDENTE
  PAGO
  CANCELADO
  EXPIRADO
}
